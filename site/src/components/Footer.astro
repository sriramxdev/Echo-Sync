---
import footerData from '../data/footer.json';
---

<footer class="border-t border-border-light dark:border-border-dark py-8 px-6 text-center text-xs text-slate-500">
  <div class="max-w-5xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4">
    <p>{footerData.copyright}</p>
    <div class="flex gap-4">
      {footerData.links.map(link => (
        <a href={link.href} class="hover:underline">{link.label}</a>
      ))}
    </div>
  </div>
</footer>