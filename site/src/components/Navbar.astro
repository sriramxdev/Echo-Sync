---
import navData from '../data/navbar.json';
---

<header class="fixed top-4 inset-x-0 max-w-5xl mx-auto px-4 z-50">
  <nav class="font-display flex items-center justify-between px-6 py-3 rounded-full border border-border-light/80 dark:border-border-dark/80 bg-surface-light/80 dark:bg-surface-dark/80 backdrop-blur-md shadow-sm">
    <a href={navData.brand.href} class="flex items-center gap-2 font-normal text-2xl tracking-wide">
      <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>{navData.brand.name}<span class="text-emerald-600 dark:text-emerald-400">{navData.brand.accent}</span></span>
    </a>

    <div class="flex items-center gap-6 text-base tracking-wider uppercase text-slate-600 dark:text-slate-300">
      {navData.links.map(link => (
        <a href={link.href} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition">
          {link.label}
        </a>
      ))}

      <button 
        id="theme-toggle" 
        aria-label="Toggle theme" 
        class="p-2 rounded-full border border-border-light dark:border-border-dark hover:bg-slate-100 dark:hover:bg-slate-800 transition cursor-pointer text-slate-600 dark:text-slate-300"
      >
        <svg id="sun-icon" class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg id="moon-icon" class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <a 
        href={navData.cta.href} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="px-4 py-1.5 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-medium tracking-wide transition shadow-sm">
        {navData.cta.label}
      </a>
    </div>
  </nav>
</header>